; Engine configuration file.
; Atlas M0–M6 — stub Mediterranean hex + ownership/annex/economy/shipping
config_version=5

[application]
config/name="Atlas Stub Med"
config/description="M0–M6 Mediterranean hex — map, army, ownership, annex, economy, shipping"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://icon.svg"

[autoload]
MapService="*res://autoload/MapService.gd"
Balance="*res://autoload/Balance.gd"
OwnershipService="*res://autoload/OwnershipService.gd"
ArmyService="*res://autoload/ArmyService.gd"
BuildingService="*res://autoload/BuildingService.gd"
EconomyService="*res://autoload/EconomyService.gd"
AnnexService="*res://autoload/AnnexService.gd"
ShippingService="*res://autoload/ShippingService.gd"
SimTick="*res://autoload/SimTick.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="forward_plus"
